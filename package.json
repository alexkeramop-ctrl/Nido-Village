{
  "name": "nido-village",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "build:cf": "node scripts/embed-migrations.mjs && NIDO_TARGET=cloudflare opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.16",
    "drizzle-orm": "^0.45.3",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.12",
    "next": "^16.4.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
