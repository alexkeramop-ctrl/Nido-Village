# Αντέγραψέ το σε .env.local για τοπική ανάπτυξη. Χωρίς DATABASE_URL χρησιμοποιείται PGlite στο .data/pglite.

# Μυστικό υπογραφής των cookies (υποχρεωτικά αλλαγή στην παραγωγή)
NIDO_SECRET=change-me-to-a-long-random-string

# store (ταμείο + εκτυπωτές, προεπιλογή) ή cloud (μόνο dashboard συνεταίρων + /api/sync)
NIDO_MODE=store

# PostgreSQL (π.χ. Supabase). Κενό = PGlite τοπικά.
# DATABASE_URL=postgres://user:pass@host:5432/nido

# Φόρτωση δεδομένων επίδειξης στην πρώτη εκκίνηση (1/0)
NIDO_SEED_DEMO=1

# Αποστολή στατιστικών στο cloud (μόνο σε store mode)
# CLOUD_SYNC_URL=https://nido-cloud.example.com
# CLOUD_SYNC_KEY=same-long-random-key-as-cloud
# CLOUD_SYNC_INTERVAL_SEC=60

# Cloud mode: πρώτος χρήστης συνεταίρου
# PARTNER_BOOTSTRAP_EMAIL=partner@example.com
# PARTNER_BOOTSTRAP_PASSWORD=at-least-8-chars
# PARTNER_BOOTSTRAP_NAME=Συνεταίρος
