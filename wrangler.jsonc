// Cloudflare Workers: POS στο pos.nidovillage.gr. Build: npm run build:cf · Deploy: npm run deploy:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nido-pos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nido-pos" }],
  "vars": {
    "NIDO_MODE": "store"
  },
  "observability": { "enabled": true },
  // Το Cloudflare δημιουργεί μόνο του την εγγραφή DNS και το πιστοποιητικό για το pos.nidovillage.gr.
  "routes": [{ "pattern": "pos.nidovillage.gr", "custom_domain": true }]
  // Βάση: Supabase μέσω Hyperdrive (προτείνεται). Δημιουργήστε το Hyperdrive στο dashboard και προσθέστε:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }]
  // Μυστικά (Settings → Variables and Secrets, τύπος Secret): NIDO_SECRET, και DATABASE_URL αν δεν χρησιμοποιείτε Hyperdrive.
}
